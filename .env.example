# AI mode: mock never calls external providers; live calls configured providers.
AI_MODE=mock
AI_STYLING_MODE=mock
AI_IMAGE_MODE=mock

# Qwen / Alibaba Cloud Model Studio OpenAI-compatible settings.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
QWEN_VISION_MODEL=qwen3.7-plus
QWEN_IMAGE_MODEL=qwen-image-3.0-pro
QWEN_IMAGE_SIZE=928*1664
QWEN_IMAGE_PLAN_LIMIT=1
IMAGE_VISITOR_DAILY_LIMIT=2
IMAGE_GLOBAL_DAILY_LIMIT=30

# DeepSeek styling settings.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Prompt and skill versions.
STYLING_PROMPT_VERSION=v0.1
STYLING_SKILL_VERSION=v0.1

# External model request timeout.
MODEL_TIMEOUT_SECONDS=120

# Local backend settings.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
